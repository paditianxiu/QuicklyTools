<UserControl
    x:Class="QuicklyTools.Views.WifiPasswordView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QuicklyTools.ViewModels.Tools"
    x:DataType="vm:WifiPasswordViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#C73939"
                   TextWrapping="Wrap" Margin="0,10,0,12" />

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Padding="32,10">
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WifiProfileViewModel">
                        <Border Background="White" BorderBrush="#E5E9F0" BorderThickness="1"
                                CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Text="{Binding Ssid}" FontSize="17"
                                           FontWeight="SemiBold" Foreground="#202833" />
                                <TextBlock Grid.Column="1" Text="{Binding Authentication}"
                                           Foreground="#778394" VerticalAlignment="Center" />
                                <SelectableTextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                           Margin="0,14,0,0" Text="{Binding PasswordText}"
                                           FontFamily="Consolas" FontSize="18" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>